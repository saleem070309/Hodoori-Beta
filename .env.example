# ═══════════════════════════════════════════════════════════════
# Hodoori (حضوري) - Environment Variables Configuration Template
# ═══════════════════════════════════════════════════════════════

# OpenRouter API Key (مفتاح النماذج الذكية لـ OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Gemini API Key (اختياري)
GEMINI_API_KEY=

# Inworld API Key (اختياري)
INWORLD_API_KEY=

# DeepInfra API Key (اختياري)
DEEPINFRA_API_KEY=
